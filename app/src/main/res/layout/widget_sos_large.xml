<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">
    <TextView
        android:id="@+id/sos_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_sos_button"
        android:gravity="center"
        android:text="@string/widget_sos"
        android:textColor="#FFFFFF"
        android:textSize="44sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1.2"
        android:orientation="vertical">
        <TextView
            android:id="@+id/sos_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/widget_status_preview"
            android:textColor="#1B6E2E"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/sos_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:text="@string/widget_contacts_preview"
            android:textColor="#182524"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_sos_hint"
            android:textColor="#5A6664"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
